    "headers": { "Content-Type": "application/json" },
    "body": "[{\"id\": 11, \"issuer_name\": \"C=US, O=Example CA\", \"common_name\": \"api.example.test\", \"name_value\": \"api.example.test\\n*.example.test\", \"not_before\": \"2025-01-01T00:00:00\", \"not_after\": \"2099-01-01T00:00:00\"}, {\"id\": 12, \"issuer_name\": \"C=US, O=Example CA\", \"common_name\": \"old.example.test\", \"name_value\": \"old.example.test\", \"not_before\": \"2018-01-01T00:00:00\", \"not_after\": \"2019-01-01T00:00:00\"}]"
  }
